# Copy to server/.env for local development. Never commit real values.
PORT=3001
# Local: mongodb://localhost:27017/voteready   Deploy: your Atlas connection string
MONGODB_URI=mongodb://localhost:27017/voteready
# Origin of the React client (leave empty in dev to allow any origin)
ALLOWED_ORIGIN=
# Gemini key for POST /ask — https://aistudio.google.com/apikey
GEMINI_API_KEY=
